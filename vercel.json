{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/analyze-brand.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/hubspot-owners.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/hubspot-clients.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/hubspot-client-details.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/fireflies-insights.js": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/client",
      "destination": "/index.html"
    },
    {
      "source": "/client/:code",
      "destination": "/index.html"
    }
  ]
}
